# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到 Git 仓库，敏感信息请只写在 .env 里。

# 开启登录鉴权
HOMEPAGE_AUTH_ENABLED=true

# 登录密码（单一全局密码，登录页只填密码、无需用户名）
HOMEPAGE_AUTH_PASSWORD=change-me-please

# 会话密钥，随机串。生成方式：openssl rand -base64 32
HOMEPAGE_AUTH_SECRET=change-me-random-string

# 外部访问地址，next-auth 必填，换成你自己的 NAS IP 或域名
HOMEPAGE_EXTERNAL_URL=http://127.0.0.1:3000

# Host 校验白名单，逗号分隔，需包含上面的访问地址
HOMEPAGE_ALLOWED_HOSTS=127.0.0.1:3000,localhost:3000

# 宿主机映射端口
HOMEPAGE_PORT=3000

# 容器内运行用户（飞牛首个用户通常是 1000）
PUID=1000
PGID=1000
